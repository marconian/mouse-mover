{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build release",
            "type": "process",
            "command": "${env:USERPROFILE}/.cargo/bin/cargo.exe",
            "args": ["build", "--locked", "--release"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Test",
            "type": "process",
            "command": "${env:USERPROFILE}/.cargo/bin/cargo.exe",
            "args": ["test", "--locked"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Clippy",
            "type": "process",
            "command": "${env:USERPROFILE}/.cargo/bin/cargo.exe",
            "args": ["clippy", "--locked", "--all-targets", "--", "-D", "warnings"],
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Check formatting",
            "type": "process",
            "command": "${env:USERPROFILE}/.cargo/bin/cargo.exe",
            "args": ["fmt", "--all", "--", "--check"],
            "problemMatcher": []
        }
    ]
}